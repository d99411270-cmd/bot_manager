TELEGRAM_BOT_TOKEN=
# Optional. Applied only to aiogram requests to the Telegram Bot API.
TELEGRAM_PROXY_URL=
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:10808
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
GOOGLE_SPREADSHEET_ID=
# Choose one credential source. Keep the real JSON outside the repository.
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON=
DEEPSEEK_TIMEOUT_SECONDS=20
DEEPSEEK_MAX_TOKENS=800
REPLY_DELAY_PROBABILITY=0.7
FOLLOWUP_DELAY_SECONDS=3600
FOLLOWUP_POLL_SECONDS=60
